    "luck": [
      { "text": "🥕 Գազարի օր։ Գազարը տալիս է կրկնակի բերք։", "yield": { "Carrot": 2 } },
      { "text": "🎃 Այսօր դդումները չեն փչանում։", "pumpkinDeath": 0 },
      { "text": "✨ Ոսկե ձկան օր։ Ոսկե ձուկը բռնվում է 3 անգամ ավելի հաճախ։", "fish": { "Golden_Fish": 3 } },
