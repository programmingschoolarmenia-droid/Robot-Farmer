      { "text": "🌻 Արևոտ օր։ Արևածաղիկները տալիս են կրկնակի էներգիա։", "yield": { "Power": 2 } },
      { "text": "🌵 Կակտուսի օր։ Կակտուսները տալիս են կրկնակի բերք։", "yield": { "Cactus": 2 } },
