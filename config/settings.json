      "Whitefish": { "chance": 20, "amount": 5, "seasons": ["Winter"] },
      "Catfish": { "chance": 15, "amount": 8, "weather": ["Rain", "Storm"] }
    },
    "hat": "Fisher_Hat"
  },

  "calendar": {
    "_readme": "Սեզոններ, եղանակ և օրվա բախտ։ Դրանք գնում են իրական ժամացույցով, ուստի բոլոր աշակերտներն ունեն նույն սեզոնը, եղանակը և բախտը։ seasonMinutes՝ մեկ սեզոնի տևողությունը րոպեներով (15 → ամեն ժամ՝ գարուն :00-ից, ամառ :15-ից, աշուն :30-ից, ձմեռ :45-ից), weatherMinutes՝ որքան հաճախ է փոխվում եղանակը։ inSeason / outOfSeason՝ աճի արագությունը բույսի սիրած սեզոնին և մյուսներին (entities.X.seasons)։ Ձմռանը հողի ջուրը սառույց է և բույսերին չի արագացնում։ weather՝ եղանակների կշիռներն ամեն սեզոնին (Arev՝ Sunny, Andzrev՝ Rain, Amprop՝ Storm, Shog՝ Heat, Dzyun՝ Snow)։ Անձրևն ու ամպրոպը լցնում են բոլոր վանդակներն ու լճակները ջրով, heatEvaporation՝ շոգին ջուրը քանի անգամ արագ է գոլորշիանում, lightningSeconds՝ ամպրոպին կայծակը քանի վայրկյանը մեկ է խփում, lightningMultiplier՝ կայծակից լիցքավորված բույսի բերքը քանի անգամ է շատ։ luck՝ օրվա բախտերը (ամեն օր մեկը, երբեք նույնը երկու օր անընդմեջ)՝ yield՝ հավաքածի բազմապատկիչ (բերք, ձուկ, ոսկի, ոսկոր), fish՝ ձկան հավանականության բազմապատկիչ, growth՝ աճի արագություն, pumpkinDeath՝ դդումի փչանալու հավանականություն։ Ամբողջ բաժինը ջնջելով սեզոններն անջատվում են։",
